/// Someone who cooks, as a name on a list.
///
/// Deliberately not a `User`: the people who cook at a hall do not have logins,
/// and giving them one to be assignable would mean a seat, an invitation and a
/// password for a name on a production sheet.
///
/// Retired rather than deleted - `is_active` is what the board filters on. A
/// dish completed last month keeps the name of whoever cooked it, which a hard
/// delete would either erase or refuse.
///
/// One constraint here lives in SQL and not in this file: a unique index on
/// (organization_id, lower(name)), added by
/// `20260820120000_add_kitchen_worker_name_unique`. `@@unique` cannot express
/// `lower()`, so it is written as a functional index and recorded here instead.
model KitchenWorker {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The staff member this worker is, when they are one.
  ///
  /// Nullable because a kitchen worker need not have a login - a casual hand
  /// hired for one Sunday gets a name and nothing else, which is what this
  /// table was originally for. Rows with a userId are kept in step with the
  /// staff list automatically, so anyone given the Kitchen Staff role is
  /// assignable without being added here by hand.
  userId         String?  @map("user_id") @db.Uuid
  name           String
  color          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization                   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                           User?                         @relation("KitchenWorkerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedKitchenItems           KitchenItemStatus[]
  assignedStandaloneKitchenItems KitchenStandaloneItemStatus[]

  @@unique([organizationId, userId])
  @@index([organizationId, isActive])
  @@index([isActive])
  @@map("kitchen_workers")
}

/// A kitchen-only production job, created from the Kitchen Dashboard.
///
/// This deliberately does not become an Event/Booking: no client, hall
/// reservation, payment, lifecycle confirmation or admin approval is implied.
/// It exists so the kitchen can cook a selected menu for a portion count, and
/// so that card survives refreshes.
model KitchenStandaloneEvent {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  menuId           String   @map("menu_id") @db.Uuid
