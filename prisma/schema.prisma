generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  phone     String?
  venueName String?  @map("venue_name")
  role      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  access                         UserAccess?
  createdEvents                  Event[]               @relation("EventCreatedBy")
  updatedEvents                  Event[]               @relation("EventUpdatedBy")
  createdSchoolCycles            SchoolCycle[]         @relation("SchoolCycleCreatedBy")
  updatedKitchenItemStatuses      KitchenItemStatus[]   @relation("KitchenItemStatusUpdatedBy")
  changedKitchenNotifications     KitchenNotification[] @relation("KitchenNotificationChangedBy")
  acknowledgedKitchenNotifications KitchenNotification[] @relation("KitchenNotificationAcknowledgedBy")
  activityLogs                   ActivityLog[]
  generatedPdfs                  GeneratedPdf[]
  sentEmailLogs                  EmailLog[]

  @@map("users")
}

model UserAccess {
  id                         String   @id @default(uuid()) @db.Uuid
  userId                     String   @unique @map("user_id") @db.Uuid
  canViewHome                Boolean  @default(true) @map("can_view_home")
  canViewCalendar            Boolean  @default(false) @map("can_view_calendar")
  canCreateBooking           Boolean  @default(false) @map("can_create_booking")
  canViewEventManager        Boolean  @default(false) @map("can_view_event_manager")
  canViewKitchenDashboard    Boolean  @default(false) @map("can_view_kitchen_dashboard")
  canViewMenu                Boolean  @default(false) @map("can_view_menu")
  canEditMenu                Boolean  @default(false) @map("can_edit_menu")
  canViewSettings            Boolean  @default(false) @map("can_view_settings")
  canEditSettings            Boolean  @default(false) @map("can_edit_settings")
  canAssignWorkers           Boolean  @default(false) @map("can_assign_workers")
  canUpdateKitchenStatus     Boolean  @default(false) @map("can_update_kitchen_status")
  canAddKitchenEvents        Boolean  @default(false) @map("can_add_kitchen_events")
  canManageSchoolSchedule    Boolean  @default(false) @map("can_manage_school_schedule")
  canSeeSchoolEvents         Boolean  @default(false) @map("can_see_school_events")
  canSeeSimchaEvents         Boolean  @default(true) @map("can_see_simcha_events")
  canViewPaymentInfo         Boolean  @default(false) @map("can_view_payment_info")
  canSendPaymentEmail        Boolean  @default(false) @map("can_send_payment_email")
  canUseNiceHomeBackground   Boolean  @default(false) @map("can_use_nice_home_background")
  allowedHallIds             String[] @default([]) @map("allowed_hall_ids")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_access")
}

model Hall {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  isActive           Boolean  @default(true) @map("is_active")
  isBookable         Boolean  @default(true) @map("is_bookable")
  basePrice          Decimal? @map("base_price") @db.Decimal(12, 2)
  perCouplePrice     Decimal? @map("per_couple_price") @db.Decimal(12, 2)
  memberBasePrice    Decimal? @map("member_base_price") @db.Decimal(12, 2)
  memberPerCouplePrice Decimal? @map("member_per_couple_price") @db.Decimal(12, 2)
  connectedHallIds   String[] @default([]) @map("connected_hall_ids")
  sharedMenuEnabled  Boolean  @default(false) @map("shared_menu_enabled")
  allowedMenuItemIds String[] @default([]) @map("allowed_menu_item_ids")
  color              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive, isBookable])
  @@map("halls")
}

model EventType {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  isActive              Boolean  @default(true) @map("is_active")
  validDays             Int[]    @default([]) @map("valid_days")
  isShabbosShevaBrachos Boolean  @default(false) @map("is_shabbos_sheva_brachos")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive])
  @@map("event_types")
}

model Event {
  id                    String   @id @default(uuid()) @db.Uuid
  clientName            String   @map("client_name")
  phone                 String
  email                 String?
  eventDate             DateTime @map("event_date") @db.Date
  hallId                String   @map("hall_id") @db.Uuid
  hallName              String?  @map("hall_name")
  eventTypeId           String?  @map("event_type_id") @db.Uuid
  eventType             String?  @map("event_type")
  eventStatus           String   @map("event_status")
  paymentStatus         String?  @map("payment_status")
  packageId             String?  @map("package_id") @db.Uuid
  packageName           String?  @map("package_name")
  couplesCount          Int      @default(0) @map("couples_count")
  menCount              Int      @default(0) @map("men_count")
  ladiesCount           Int      @default(0) @map("ladies_count")
  boysCount             Int      @default(0) @map("boys_count")
  girlsCount            Int      @default(0) @map("girls_count")
  kidsCount             Int      @default(0) @map("kids_count")
  waitersCount          Int      @default(0) @map("waiters_count")
  setupTime             String?  @map("setup_time")
  washingTime           String?  @map("washing_time")
  tableclothId          String?  @map("tablecloth_id") @db.Uuid
  tableclothName        String?  @map("tablecloth_name")
  notes                 String?
  daveningNote          String?  @map("davening_note")
  sideBoxes             Json?    @map("side_boxes")
  menuItemIds           String[] @default([]) @map("menu_item_ids")
  drinkItemIds          String[] @default([]) @map("drink_item_ids")
  addOnIds              String[] @default([]) @map("add_on_ids")
  isMemberRate          Boolean  @default(false) @map("is_member_rate")
  memberShulName        String?  @map("member_shul_name")
  regularPriceTotal     Decimal? @map("regular_price_total") @db.Decimal(12, 2)
  memberPriceTotal      Decimal? @map("member_price_total") @db.Decimal(12, 2)
  finalTotal            Decimal? @map("final_total") @db.Decimal(12, 2)
  amountDue             Decimal? @map("amount_due") @db.Decimal(12, 2)
  layoutFileUrl         String?  @map("layout_file_url")
  layoutFileType        String?  @map("layout_file_type")
  shabbosSetup          Json?    @map("shabbos_setup")
  sharedMenuSourceEventId String? @map("shared_menu_source_event_id") @db.Uuid
  googleCalendarEventId String?  @map("google_calendar_event_id")
  googleSyncStatus      String?  @map("google_sync_status")
  googleLastSyncedAt    DateTime? @map("google_last_synced_at")
  googleSyncError       String?  @map("google_sync_error")
  createdById           String?  @map("created_by") @db.Uuid
  updatedById           String?  @map("updated_by") @db.Uuid
  deleted               Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  hall                  Hall              @relation(fields: [hallId], references: [id])
  eventTypeSetting      EventType?        @relation(fields: [eventTypeId], references: [id])
  package               EventPackage?     @relation(fields: [packageId], references: [id])
  tablecloth            TableclothOption? @relation(fields: [tableclothId], references: [id])
  sharedMenuSourceEvent Event?            @relation("SharedMenuSource", fields: [sharedMenuSourceEventId], references: [id])
  sharedMenuEvents      Event[]           @relation("SharedMenuSource")
  createdBy             User?             @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?             @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  kitchenItemStatuses   KitchenItemStatus[]
  kitchenNotifications  KitchenNotification[]
  activityLogs          ActivityLog[]
  generatedPdfs         GeneratedPdf[]
  emailLogs             EmailLog[]

  @@index([eventDate])
  @@index([hallId, eventDate])
  @@index([eventStatus, eventDate])
  @@index([paymentStatus])
  @@index([clientName])
  @@index([phone])
  @@index([deleted])
  @@map("events")
}

model MenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  category      String?
  usageType     String   @map("usage_type")
  kosherType    String?  @map("kosher_type")
  countingRules Json?    @map("counting_rules")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kitchenItemStatuses KitchenItemStatus[]

  @@index([category])
  @@index([usageType])
  @@index([isActive])
  @@map("menu_items")
}

model EventPackage {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  hallIds              String[] @default([]) @map("hall_ids")
  eventTypeIds         String[] @default([]) @map("event_type_ids")
  regularPrice         Decimal? @map("regular_price") @db.Decimal(12, 2)
  memberPrice          Decimal? @map("member_price") @db.Decimal(12, 2)
  includedMenuItemIds  String[] @default([]) @map("included_menu_item_ids")
  includedDrinkItemIds String[] @default([]) @map("included_drink_item_ids")
  notes                String?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive])
  @@map("packages")
}

model AddOn {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  price            Decimal? @db.Decimal(12, 2)
  pricingType      String   @map("pricing_type")
  hallIds          String[] @default([]) @map("hall_ids")
  isKitchenVisible Boolean  @default(false) @map("is_kitchen_visible")
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("add_ons")
}

model KitchenWorker {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  color     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedKitchenItems KitchenItemStatus[]

  @@index([isActive])
  @@map("kitchen_workers")
}

model KitchenItemStatus {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  menuItemId       String   @map("menu_item_id") @db.Uuid
  status           String
  assignedWorkerId String?  @map("assigned_worker_id") @db.Uuid
  updatedById      String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem       MenuItem       @relation(fields: [menuItemId], references: [id])
  assignedWorker KitchenWorker? @relation(fields: [assignedWorkerId], references: [id])
  updatedBy      User?          @relation("KitchenItemStatusUpdatedBy", fields: [updatedById], references: [id])

  @@unique([eventId, menuItemId])
  @@index([status])
  @@index([assignedWorkerId])
  @@map("kitchen_item_statuses")
}

model KitchenNotification {
  id                     String    @id @default(uuid()) @db.Uuid
  eventId                String?   @map("event_id") @db.Uuid
  notificationType       String    @map("notification_type")
  eventDate              DateTime? @map("event_date") @db.Date
  hallOrRoom             String?   @map("hall_or_room")
  eventType              String?   @map("event_type")
  message                String
  oldValue               Json?     @map("old_value")
  newValue               Json?     @map("new_value")
  changedById            String?   @map("changed_by") @db.Uuid
  requiresAcknowledgment Boolean   @default(true) @map("requires_acknowledgment")
  acknowledgedById       String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt         DateTime? @map("acknowledged_at")
  emailSent              Boolean   @default(false) @map("email_sent")
  emailSentAt            DateTime? @map("email_sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  event          Event? @relation(fields: [eventId], references: [id])
  changedBy      User?  @relation("KitchenNotificationChangedBy", fields: [changedById], references: [id])
  acknowledgedBy User?  @relation("KitchenNotificationAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([eventDate])
  @@index([requiresAcknowledgment])
  @@index([emailSent])
  @@map("kitchen_notifications")
}

model SchoolCycle {
  id          String   @id @default(uuid()) @db.Uuid
  cycleName   String   @map("cycle_name")
  cycleType   String   @map("cycle_type")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  days        Json
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("SchoolCycleCreatedBy", fields: [createdById], references: [id])

  @@index([cycleType])
  @@index([startDate, endDate])
  @@map("school_cycles")
}

model MemberShul {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @unique
  createdFromBooking Boolean  @default(false) @map("created_from_booking")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("member_shuls")
}

model PaymentSetting {
  id                       String   @id @default(uuid()) @db.Uuid
  paymentLink              String   @map("payment_link")
  connectedGmailAccount    String?  @map("connected_gmail_account")
  paymentEmailSubject      String?  @map("payment_email_subject")
  paymentEmailHtmlTemplate String?  @map("payment_email_html_template")
  sendFromGoogleEnabled    Boolean  @default(false) @map("send_from_google_enabled")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model TableclothOption {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  colorOrDescription String?  @map("color_or_description")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive])
  @@map("tablecloth_options")
}

model MenuCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("menu_categories")
}

model HolidayBlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  label     String
  reason    String?
  isBlocked Boolean  @default(true) @map("is_blocked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startDate, endDate])
  @@index([isBlocked])
  @@map("holiday_blocked_dates")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  userName   String?  @map("user_name")
  actionType String   @map("action_type")
  message    String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}

model GeneratedPdf {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  fileUrl     String   @map("file_url")
  fileName    String   @map("file_name")
  generatedById String? @map("generated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event @relation(fields: [eventId], references: [id])
  generatedBy User? @relation(fields: [generatedById], references: [id])

  @@index([eventId])
  @@map("generated_pdfs")
}

model EmailLog {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String?  @map("event_id") @db.Uuid
  emailType    String   @map("email_type")
  toEmail      String   @map("to_email")
  fromEmail    String?  @map("from_email")
  subject      String?
  status       String
  errorMessage String?  @map("error_message")
  sentById     String?  @map("sent_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  event  Event? @relation(fields: [eventId], references: [id])
  sentBy User?  @relation(fields: [sentById], references: [id])

  @@index([eventId])
  @@index([emailType])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}
