/// Supabase MFA factors this application TRUSTS.
///
/// A factor being `verified` in Supabase means somebody proved they hold the
/// secret. It does not mean the account owner put it there - anyone signed in
/// with the password can enroll one directly against Supabase. Only a factor
/// listed here satisfies two-factor authentication in this app, and a factor
/// only gets here through an email-verified enrollment grant (or the one-off
/// backfill of factors that existed before this table did).
model MfaTrustedFactor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// `auth.mfa_factors.id`. Unique: one factor, one trust decision.
  factorId  String   @unique @map("factor_id") @db.Uuid
  /// "email_verified" or "legacy_backfill".
  source    String
  trustedAt DateTime @default(now()) @map("trusted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_trusted_factors")
}

