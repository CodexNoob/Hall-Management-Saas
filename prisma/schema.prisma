/// Where a person is signed in, so they can see it and act on it.
///
/// Supabase owns the real sessions, and its admin API can revoke broadly -
/// `signOut(jwt, "others")` - but cannot ENUMERATE them: the whole surface is
/// signOut, invite, generateLink, createUser, listUsers, getUserById,
/// updateUserById, deleteUser. A list therefore has to be recorded here or not
/// exist at all.
///
/// Deliberately NOT tenant-scoped. A session belongs to a person, not to one of
/// the organizations they work for - somebody in two halls signs in once and
/// gets one row, and seeing their own devices is not an act inside either
/// tenant. That is also why RLS on this table is deny-all rather than the usual
/// organization predicate: nothing reads it from the browser, only the API.
model UserSession {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  deviceId String? @map("device_id") @db.Uuid

  /// The `session_id` claim on the Supabase access token.
  ///
  /// The join between our row and the session Supabase actually holds, which is
  /// what lets the list mark "this device" and lets a refreshed token update
  /// the row it already has rather than creating a second one. Unique, because
  /// one Supabase session is one row by definition.
  sessionId String @unique @map("session_id")

  /// What the browser said it was. Parsed for display, stored raw - a
  /// user-agent this build cannot parse should still be shown to its owner
  /// rather than reduced to "Unknown".
  userAgent String? @map("user_agent")

  /// Personal data, stored on purpose and only here: it is the field that
  /// makes "that is not me" answerable. Never logged - see docs/logging.md,
  /// which keeps identifying detail out of the log stream by construction.
  ipAddress String? @map("ip_address")

  /// Roughly where the request came from, as the edge already resolved it.
  ///
  /// Read from the platform's own headers rather than by asking a geolocation
  /// service: the answer is on the request already, so no IP address leaves
  /// our infrastructure to get it and there is no key, cost or vendor to
  /// track. It also means these are null in local development, where there is
  /// no edge in front of the app.
  ///
  /// Approximate by nature - an IP resolves to a network, not a person - and
  /// the screen says so. It is here to answer "was that me?", where being
  /// roughly right is the whole value.
  city    String? @map("city")
  /// State or province, where the edge resolved one.
  ///
  /// It earns its place where a city name is ambiguous across states -
  /// Springfield, Portland, Columbus - which is most of the United States. In a
  /// country with one Manila it adds nothing, and being null there is correct
  /// rather than a gap.
  ///
  /// Deliberately NOT accompanied by latitude and longitude. Both are on the
  /// request too, and both come from the same IP lookup as the city - so they
  /// are no more accurate, buy nothing without a map to plot them on, and would
  /// put a precise-looking number against a named employee for no reason.
  region  String? @map("region")
  /// ISO 3166-1 alpha-2. Stored as the code and named at render, so the same
  /// row reads "Philippines" or "Filipinas" depending on who is looking.
  country String? @map("country")

  /// When somebody last actually DID something on this session.
  ///
  /// Distinct from `lastSeenAt` below, and the distinction is the feature.
  /// `lastSeenAt` is touched by the session sync, which the dashboard polls
  /// every sixty seconds while the tab is visible - so it says "this session is
  /// alive", which a screen left open on a desk says forever. This is written
  /// only by a deliberate interaction ping, so it says "a person was here".
  ///
  /// Null means "no activity has ever been recorded", which reads as ACTIVE.
  /// Every session that predates this column has one, and treating null as
  /// stale would sign out every open session the moment it deployed.
  lastActiveAt DateTime? @map("last_active_at")

  /// A screen that is unattended on purpose - the kitchen board on the wall.
  ///
  /// Exempt from the inactivity timeout. Per device rather than per role: it is
  /// a fact about the screen, not the person, and the same cook on their own
  /// phone should time out like anybody else.
  sharedDevice Boolean @default(false) @map("shared_device")

  createdAt  DateTime  @default(now()) @map("created_at")
  /// Touched by the session sync, which the dashboard calls on every cold load
  /// past its five-minute cache. That is the heartbeat "last seen" reads.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, lastSeenAt])
  @@index([deviceId])
  @@map("user_sessions")
}

/// A six-digit code emailed to the account's own address, and - once it has
/// been entered correctly - the short-lived GRANT it turns into.
///
/// WHY IT EXISTS. Setting up an authenticator is a conversation between the
/// browser and Supabase, and Supabase will enroll a factor for any session that
/// holds the password. Without this, a stolen password was enough to attach
/// the thief's own authenticator. The grant is how the server tells an
/// authenticator the account owner set up (they could read their email) from
/// one somebody else attached - see lib/auth/mfa-trust.ts.
///
/// THE CODE IS NEVER STORED. `codeHash` is an HMAC keyed with a server secret
/// and salted with the row id, so a copy of this table does not hand over a
/// live code, and six digits cannot be brute-forced offline without the key.
///
/// TIED TO ONE SUPABASE SESSION. `sessionId` is the `session_id` claim of the
/// token that asked; the grant only counts for that same session.
model EmailSecurityCode {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// The organization the request was made in, for the audit trail. Not a
  /// foreign key: the row belongs to the person and goes with their account.
  organizationId String    @map("organization_id") @db.Uuid
  /// What the code is FOR - "MFA_ENROLLMENT" or "DEVICE_TRUST". Text rather
  /// than an enum, like every other kind column in this schema;
  /// `SecurityCodePurpose` in lib/auth/security-codes.ts is the closed list.
  purpose        String
  sessionId      String    @map("session_id")
  codeHash       String    @map("code_hash")
  /// Wrong entries so far. Five and the code is dead.
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at")
  /// Set when the right code was entered. From then until `grantExpiresAt`
  /// this row IS the grant.
  verifiedAt     DateTime? @map("verified_at")
  grantExpiresAt DateTime? @map("grant_expires_at")
  /// Spent - by trusting a factor, or by being replaced by a newer code. A
  /// consumed row can never be verified or used again.
  consumedAt     DateTime? @map("consumed_at")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  /// For a DEVICE_TRUST code, the device it confirms. A code for one browser
  /// can never confirm another.
  deviceId       String?   @map("device_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// The two lookups: "the live code for this person and purpose", and the
  /// hourly send count.
  @@index([userId, purpose, createdAt])
  @@index([deviceId])
  @@map("email_security_codes")
}

/// A browser this person has signed in from - KNOWN once seen, CONFIRMED once
/// they verify the email code, and TRUSTED only when it is the primary device.
///
/// Identified by a random secret in an httpOnly cookie; only an HMAC of it is
/// stored here (lib/auth/device-identity.ts), so this table cannot be used to
/// impersonate a device. Scoped per user: one browser shared by two people is
/// two rows, and trusting it for one says nothing about the other.
///
/// Confirmation clears the device gate but never replaces the password or
/// second factor. `trustedAt` identifies the confirmed primary device that
/// bulk sign-out preserves; it does not skip any authentication step.
///
/// Separate from `user_sessions`: a session ends at sign-out, a device outlives
/// many sessions.
model UserDevice {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  deviceHash         String    @map("device_hash")
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  /// The single device retained by "sign out everywhere". The database
  /// assigns this to the first device sighting for each user.
  isPrimary          Boolean   @default(false) @map("is_primary")
  /// When the owner last confirmed this browser with the emailed code.
  /// Trust lasts until `trustExpiresAt` (lib/auth/device-trust-policy.ts).
  confirmedAt        DateTime? @map("confirmed_at")
  /// The primary device's confirmation - what "sign out on untrusted
  /// devices" preserves. Not what the device gate reads.
  trustedAt          DateTime? @map("trusted_at")
  /// Fixed from the confirmation; using the device does not extend it. After
  /// it, the browser is verified again like a new one.
  trustExpiresAt     DateTime? @map("trust_expires_at")
  /// When the authenticator code was last entered on this device during its
  /// current trust period. Lets a sign-in here skip the code, unless the
  /// organization requires 2FA. Cleared by revocation and re-confirmation.
  mfaVerifiedAt      DateTime? @map("mfa_verified_at")
  /// Removed from My Account. The same browser returning is treated as new
  /// again: untrusted, and confirmed from scratch.
  revokedAt          DateTime? @map("revoked_at")
  /// When the new-device email went out - so it goes out once, not on every
  /// page load.
