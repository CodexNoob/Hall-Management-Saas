/// What an event is serving, as a document: this header plus its lines.
///
/// Replaces `Event.menuItemIds`, a bare uuid array with no foreign key, no
/// ordering and nowhere to record anything about a dish on this particular
/// event. That array is still written as a mirror until the readers that have
/// not moved over yet - the kitchen dashboard and the event PDF - are repointed.
///
/// `meal` is 'Main' for every event today. It exists so a Shabbos event serving
/// three separate menus is an INSERT rather than a migration.
model EventMenu {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  meal           String    @default("Main")
  /// The style the lines inherit when they do not name one of their own.
  serviceStyle   String?   @map("service_style")
  /// Draft | ClientSubmitted | Confirmed. Lifted out of
  /// `Event.workspaceData.menuConfirmed`, a bare json boolean that had nowhere
  /// to record who confirmed the menu or when.
  status         String    @default("Draft")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String?   @map("confirmed_by") @db.Uuid
  /// Checked on write. The array this replaces was read-modify-written by three
  /// separate routes, so two people editing one menu was last-write-wins.
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  confirmedBy  User?           @relation("EventMenuConfirmedBy", fields: [confirmedById], references: [id])
  lines        EventMenuLine[]

  @@unique([eventId, meal])
  @@index([organizationId, status])
  @@map("event_menus")
}

/// One thing the event is getting: a dish, or an add-on.
///
/// Exactly one of `menuItemId` / `addOnId` is set, enforced by a CHECK. The two
/// are separate tables today - an add-on carries a price and a dish carries
/// production rules - but on an event they are the same kind of thing, a line
/// on the menu, and giving them one table means add-ons get the ordering, the
/// confirmation lock and the delete protection dishes get instead of staying in
/// a bare id array beside them.
model EventMenuLine {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  eventMenuId        String   @map("event_menu_id") @db.Uuid
  menuItemId         String?  @map("menu_item_id") @db.Uuid
  addOnId            String?  @map("add_on_id") @db.Uuid
  /// Null while the menu is a draft, filled when it is confirmed: a draft
  /// should follow a library rename, a confirmed menu must not change under
  /// the kitchen that already read it.
  itemName           String?  @map("item_name")
  /// Which way this dish is served at this event, and therefore which of its
  /// `MenuItemService` rules the quantity math runs. Null on an add-on, which
  /// is not served in a style at all.
  serviceStyle       String?  @map("service_style")
  notes              String?
  sortOrder          Int      @default(0) @map("sort_order")
  /// How many complete servings of this line the event is getting - "2x the
  /// brisket". Multiplies the finished kitchen quantity, so two of a dish that
  /// works out at 7 trays is 14 trays - not the 13 that doubling the guest count
  /// before rounding would give, and not the 2 that a per-tray minimum would
  /// swallow the doubling into.
  ///
  /// Not `MenuItemService.quantity`, which is the rate for ONE serving.
  ///
  /// A column rather than a second row: the uniques below make a repeated dish
  /// unstorable, and `KitchenItemStatus` is keyed on (event, dish) anyway, so a
  /// duplicate row could not carry its own progress even if it existed.
  quantityMultiplier Int      @default(1) @map("quantity_multiplier")
  /// Manual | Package | ClientPortal. 'Package' is unused until packages
  /// materialise their items onto the event; it reserves the room.
  source             String   @default("Manual")
  addedById          String?  @map("added_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventMenu    EventMenu    @relation(fields: [eventMenuId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting something an event is still serving is
  /// what the delete route prevents today with an org-wide sequential scan over
  /// `menu_item_ids`. With the foreign key here it is an index lookup.
  menuItem     MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  addOn        AddOn?       @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  addedBy      User?        @relation("EventMenuLineAddedBy", fields: [addedById], references: [id])

  /// A dish appears once per menu, carrying the one style it is served in.
  /// Nulls do not collide in a unique index, so add-on lines are unaffected by
  /// this one and dish lines are unaffected by the next.
  @@unique([eventMenuId, menuItemId])
  @@unique([eventMenuId, addOnId])
  @@index([organizationId, eventMenuId, sortOrder])
  @@index([menuItemId])
  @@index([addOnId])
  @@map("event_menu_lines")
}

model HolidayBlockedDate {
