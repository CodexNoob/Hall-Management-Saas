  girlsCount              Int       @default(0) @map("girls_count")
  kidsCount               Int       @default(0) @map("kids_count")
  waitersCount            Int       @default(0) @map("waiters_count")
  setupTime               String?   @map("setup_time")
  washingTime             String?   @map("washing_time")
  tableclothId            String?   @map("tablecloth_id") @db.Uuid
