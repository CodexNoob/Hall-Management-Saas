  eventDate        DateTime @map("event_date") @db.Date
  portions         Int
  kitchenNote      String?  @map("kitchen_note")
  includedAddOnIds String[] @default([]) @map("included_add_on_ids")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         EventPackage                  @relation(fields: [menuId], references: [id], onDelete: Restrict)
  createdBy    User?                         @relation("KitchenStandaloneEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  itemStatuses KitchenStandaloneItemStatus[]

  @@index([organizationId, eventDate])
  @@index([organizationId, menuId])
  @@map("kitchen_standalone_events")
}

/// Progress and assignment for one dish on a kitchen-only production job.
model KitchenStandaloneItemStatus {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  kitchenStandaloneEventId String   @map("kitchen_standalone_event_id") @db.Uuid
  menuItemId               String   @map("menu_item_id") @db.Uuid
  status                   String?
  assignedWorkerId         String?  @map("assigned_worker_id") @db.Uuid
  updatedById              String?  @map("updated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitchenStandaloneEvent KitchenStandaloneEvent @relation(fields: [kitchenStandaloneEventId], references: [id], onDelete: Cascade)
  menuItem               MenuItem               @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  assignedWorker         KitchenWorker?         @relation(fields: [assignedWorkerId], references: [id])
  updatedBy              User?                  @relation("KitchenStandaloneItemStatusUpdatedBy", fields: [updatedById], references: [id])

  @@unique([kitchenStandaloneEventId, menuItemId])
  @@index([organizationId, status])
  @@index([assignedWorkerId])
  @@map("kitchen_standalone_item_statuses")
}

/// What the kitchen has done to one dish on one event, and who is on it.
///
/// The two are independent, which is why `status` is nullable: a row can exist
/// to say "Mendy is doing this" about a dish nobody has started. Before that,
/// assigning a worker had to invent a status, and invented 'PENDING' - so
/// planning tomorrow's work reported it as already underway.
///
/// Null means not started, and so does no row at all. The board's reset deletes
/// the row; assigning and then unassigning leaves nothing behind either.
model KitchenItemStatus {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  menuItemId       String   @map("menu_item_id") @db.Uuid
  /// PENDING or COMPLETE, or null for not started. Plain text with no CHECK
  /// behind it, so readers treat an unrecognised value as started-not-finished.
  status           String?
  assignedWorkerId String?  @map("assigned_worker_id") @db.Uuid
  updatedById      String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem       MenuItem       @relation(fields: [menuItemId], references: [id])
  assignedWorker KitchenWorker? @relation(fields: [assignedWorkerId], references: [id])
  updatedBy      User?          @relation("KitchenItemStatusUpdatedBy", fields: [updatedById], references: [id])

  @@unique([eventId, menuItemId])
  @@index([organizationId, status])
  @@index([status])
  @@index([assignedWorkerId])
  @@map("kitchen_item_statuses")
}

