/// One row per notification actually sent, so a replay cannot send it twice.
///
/// `kitchen_notifications` carries its own `emailSent` flag and that works
/// because the row IS the thing being emailed. Event confirmations have no such
/// row - created, updated and cancelled are three notifications against one
/// event - so the record lives here, keyed on what the notification WAS.
///
/// DELIBERATELY HOLDS NO PERSONAL DATA. A count, never a recipient list: this
/// answers "was it sent, and to how many", which is what a support question
/// needs. Storing who would put a list of email addresses against every booking
/// change, for a question nobody asks.
model NotificationDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// e.g. "event.created:<eventId>:<idempotency key>". Unique per tenant, which
  /// is what makes a retried request send one email rather than two.
  dedupeKey      String   @map("dedupe_key")
  /// The `NotificationKind`. Text, because a new kind should be a code change
  /// rather than a migration, and nothing branches on it.
  kind           String
  recipientCount Int      @default(0) @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey], map: "notification_deliveries_org_key")
  @@index([organizationId, createdAt], map: "notification_deliveries_org_created")
  @@map("notification_deliveries")
}

