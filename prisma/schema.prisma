  @@index([hallMapPresetId])
  @@map("dining_plans")
}

model HallMapPreset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  hallId         String   @map("hall_id") @db.Uuid
  name           String
  objects        Json     @default("[]")
  backgroundPath String?  @map("background_path")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hall         Hall         @relation(fields: [hallId], references: [id], onDelete: Cascade)
  diningPlans  DiningPlan[]

  @@unique([organizationId, hallId, name])
  @@index([organizationId, hallId, updatedAt])
  @@map("hall_map_presets")
}

model HallMapShapeLibraryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  shapeType      String   @map("shape_type")
  width          Int
  height         Int
  seats          Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
  @@map("hall_map_shape_library_items")
}
