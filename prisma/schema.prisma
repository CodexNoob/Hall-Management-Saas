generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String    @unique
  isActive              Boolean   @default(true) @map("is_active")
  trialStartedAt        DateTime? @map("trial_started_at")
  trialEndsAt           DateTime? @map("trial_ends_at")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  subscriptionPlan      String?   @map("subscription_plan")
  subscriptionStartedAt DateTime? @map("subscription_started_at")
  subscriptionEndsAt    DateTime? @map("subscription_ends_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// Bumped by a DATABASE TRIGGER on every write to `principal_roles`,
  /// `principal_permissions` and `role_permissions`. It is part of the
  /// resolver's cache key, so a privilege edit invalidates every cached decision
  /// instantly - no TTL, no cross-instance invalidation protocol, no stale
  /// window to reason about.
  ///
  /// The bump is a trigger rather than an application-side write because a
  /// trigger cannot be forgotten by a future write path, and the failure mode of
  /// forgetting is a user keeping a permission that was revoked minutes ago. It
  /// also takes a row lock on this table, which serialises concurrent matrix
  /// edits and closes the read-modify-write window by construction.
  ///
  /// BigInt, not Int: a counter with no reset needs more than 2.1 billion of
  /// headroom. It crosses the wire as a Number - exact below 2^53, which no
  /// amount of privilege editing reaches.
  permissionsEpoch      BigInt    @default(0) @map("permissions_epoch")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  primaryUsers                  User[]                        @relation("PrimaryOrganization")
  memberships                   OrganizationMembership[]
  principals                    Principal[]
  serviceAccounts               ServiceAccount[]
  roles                         Role[]
  principalRoles                PrincipalRole[]
  principalPermissions          PrincipalPermission[]
  authorizationAudits           AuthorizationAudit[]
  halls                         Hall[]
  eventTypes                    EventType[]
  events                        Event[]
  menuItems                     MenuItem[]
  menuItemServices              MenuItemService[]
  eventMenus                    EventMenu[]
  eventMenuLines                EventMenuLine[]
  eventPackages                 EventPackage[]
  addOns                        AddOn[]
  kitchenWorkers                KitchenWorker[]
  kitchenStandaloneEvents       KitchenStandaloneEvent[]
  kitchenStandaloneItemStatuses KitchenStandaloneItemStatus[]
  kitchenItemStatuses           KitchenItemStatus[]
  kitchenNotifications          KitchenNotification[]
  schoolCycles                  SchoolCycle[]
  memberShuls                   MemberShul[]
  paymentSettings               PaymentSetting[]
  tableclothOptions             TableclothOption[]
  menuCategories                MenuCategory[]
  holidayBlockedDates           HolidayBlockedDate[]
  activityLogs                  ActivityLog[]
  generatedPdfs                 GeneratedPdf[]
  emailLogs                     EmailLog[]
  storedFiles                   StoredFile[]
  fileFolders                   FileFolder[]
  paymentTransactions           PaymentTransaction[]
  paymentRefunds                PaymentRefund[]
  paymentReceipts               PaymentReceipt[]
  paymentWebhookEvents          PaymentProviderWebhookEvent[]
  bankConnections               BankConnection[]
  bankTransactions              BankTransaction[]
  vendors                       Vendor[]
  invoices                      Invoice[]
  invoiceLineItems              InvoiceLineItem[]
  invoiceDiscounts              InvoiceDiscount[]
  invoiceTaxes                  InvoiceTax[]
  invoicePaymentSchedules       InvoicePaymentSchedule[]
  invoiceBalances               InvoiceBalance[]
  settings                      OrganizationSetting?
  notificationPreferences       NotificationPreference[]
  notificationDeliveries        NotificationDelivery[]
  clients                       Client[]
  bookingReservations           BookingReservation[]
  todayNotes                    TodayNote[]
  diningPlans                   DiningPlan[]
  hallMapPresets                HallMapPreset[]
  hallMapShapeLibraryItems      HallMapShapeLibraryItem[]
  supportTickets                SupportTicket[]
  supportTicketMessages         SupportTicketMessage[]

  @@index([isActive])
  @@map("organizations")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  status         String    @default("subscribed")
  source         String    @default("website_footer")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

model ContactSupportRequest {
  id        String   @id @default(uuid()) @db.Uuid
  reference String   @unique
  name      String
  email     String
  company   String?
  message   String
  status    String   @default("NEW")
  source    String   @default("public_contact_form")
  pageUrl   String?  @map("page_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("contact_support_requests")
}

/// A request to open an Event Core account, and the decision on it.
///
/// GLOBAL, NOT TENANT-SCOPED, and necessarily so: this row exists precisely
/// because there is no organization yet. It is what stands between a verified
/// Supabase identity and `provisionOwner` creating a tenant for it. Same shape
/// as `contact_support_requests` - written through the privileged Prisma
/// connection, never read from a browser, RLS on with no policy granted.
///
/// TWO UNIQUE KEYS, deliberately. `email` catches somebody registering the same
/// address twice, which is the common case and the only one the public form can
/// see - it runs before any session exists. `supabaseAuthId` catches the same
/// authenticated identity arriving by another route, and is what makes the
/// Google path safe: signing in with Google after registering by password must
/// find the existing request rather than open a second one.
model BetaAccessRequest {
  id             String    @id @default(uuid()) @db.Uuid
  /// Lower-cased and trimmed by the application before it is written.
  email          String    @unique
  /// Null until an authenticated identity claims this request - the public form
  /// records one before Supabase has issued a session. Unique so two identities
  /// can never share a request.
  supabaseAuthId String?   @unique @map("supabase_auth_id")
  status         String    @default("PENDING")
  /// "email_password" or "google", when the recording path can tell. Null when
  /// it cannot, which is why the notification says "if available".
  signupMethod   String?   @map("signup_method")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  /// When the team was told. Best-effort: mail is sent after the row commits,
  /// so a delivery failure leaves this NULL rather than losing the request.
  notifiedAt     DateTime? @map("notified_at")
  decidedAt      DateTime? @map("decided_at")
  /// Free text naming whoever decided. Not a foreign key: the decision is made
  /// from a script, by a person who may have no row in this database at all.
  decidedBy      String?   @map("decided_by")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, requestedAt])
  @@map("beta_access_requests")
}

model ApiRateLimitBucket {
  id           String   @id
  requestCount Int      @default(1) @map("request_count")
  windowStart  DateTime @default(now()) @map("window_start")
  expiresAt    DateTime @map("expires_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("api_rate_limit_buckets")
}

/// A human's seat in one organization.
///
/// NO `role` COLUMN, DELIBERATELY. A membership points at a principal, and
/// grants attach to the principal - so what this person may do is answered by
/// `principal_roles` and `principal_permissions`, never by a string here. A role
/// column would be a second, un-scoped, un-expiring, un-audited privilege path,
/// and the whole design turns on there being exactly one (INV-2).
model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// The subject of every grant this person holds here. One-to-one and NOT
  /// NULL: a membership without a principal could hold nothing, so it would be
  /// a seat that silently denies everything.
  principalId    String   @unique @map("principal_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Composite, so a membership in organization X cannot name a principal that
  /// lives in organization Y. Structural rather than forbidden by a code path
  /// someone can forget to write.
  principal         Principal    @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The events this member is running. Read side of `Event.coordinator`.
  coordinatedEvents Event[]      @relation("EventCoordinator")

  @@unique([organizationId, userId])
  /// Required by Prisma to express the composite one-to-one above; `principalId`
  /// is already unique on its own, so this constrains nothing further. Kept
  /// because dropping it makes the relation one-to-many, and a membership with
  /// two principals is exactly the ambiguity the design has no answer for.
  @@unique([principalId, organizationId])
  @@index([userId, isActive])
  @@index([organizationId, isActive])
  @@map("organization_memberships")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  supabaseAuthId String?   @unique @map("supabase_auth_id") @db.Uuid
  name           String
  email          String    @unique
  phone          String?
  venueName      String?   @map("venue_name")
  /// This person's own dashboard language, or null to follow whatever the
  /// organization is set to.
  ///
  /// Null rather than a default on purpose: the organization's setting has to
  /// keep applying to everyone who has never expressed a preference, including
  /// people who join later, and a column defaulted to "en-US" could not tell
  /// "I want English" apart from "I never chose". It lives on the user rather
  /// than on the membership because it is a fact about the person, and somebody
  /// who reads Spanish reads Spanish in both of the halls they work for.
  language       String?
  /// Job title, shown in the staff directory. NOT a privilege - a person in two
  /// organizations has one of these and two sets of grants, which is why the
  /// old global `role` column had to go: `POST /api/staff` wrote an invite's
  /// role here, and the next sign-in copied it into the invitee's PRIMARY
  /// organization. What anyone may do now lives in `principal_roles`.
  title          String?
  isActive       Boolean   @default(true) @map("is_active")
  passwordSetAt  DateTime? @map("password_set_at")
  /// When a verified AND TRUSTED second factor was last observed on this
  /// account, or null for none. A MIRROR of Supabase's factor list filtered
  /// through `mfa_trusted_factors`, not the authority for either - the factors
  /// themselves live in `auth.mfa_factors` and only Supabase verifies a code.
  ///
  /// "Trusted" matters: a factor somebody attached with a stolen password is
  /// verified in Supabase and still does not count here (lib/auth/mfa-trust.ts).
  ///
  /// Kept here because enforcement has to ask "does this person owe a second
  /// factor?" on every authenticated request, and the alternative is a round
  /// trip to the Auth server on the hottest path in the application. Written
  /// only by server code that has just read the real list out of Supabase with
  /// the user's own token - never from a value the browser reported.
  mfaEnrolledAt  DateTime? @map("mfa_enrolled_at")
  // Mirrors Supabase's own last_sign_in_at. Provisioning compares the two to
  // tell a genuine new session from a browser cache miss, so the
  // "auth.login.success" audit entry is written once per sign-in rather than
  // every few minutes per active session.
  lastSignInAt   DateTime? @map("last_sign_in_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization                         Organization                  @relation("PrimaryOrganization", fields: [organizationId], references: [id])
  sessions                             UserSession[]
  emailSecurityCodes                   EmailSecurityCode[]
  mfaTrustedFactors                    MfaTrustedFactor[]
  devices                              UserDevice[]
  memberships                          OrganizationMembership[]
  createdEvents                        Event[]                       @relation("EventCreatedBy")
  updatedEvents                        Event[]                       @relation("EventUpdatedBy")
  createdSchoolCycles                  SchoolCycle[]                 @relation("SchoolCycleCreatedBy")
  updatedKitchenItemStatuses           KitchenItemStatus[]           @relation("KitchenItemStatusUpdatedBy")
  updatedKitchenStandaloneItemStatuses KitchenStandaloneItemStatus[] @relation("KitchenStandaloneItemStatusUpdatedBy")
  createdKitchenStandaloneEvents       KitchenStandaloneEvent[]      @relation("KitchenStandaloneEventCreatedBy")
  confirmedEventMenus                  EventMenu[]                   @relation("EventMenuConfirmedBy")
  addedEventMenuLines                  EventMenuLine[]               @relation("EventMenuLineAddedBy")
  changedKitchenNotifications          KitchenNotification[]         @relation("KitchenNotificationChangedBy")
  acknowledgedKitchenNotifications     KitchenNotification[]         @relation("KitchenNotificationAcknowledgedBy")
  activityLogs                         ActivityLog[]
  generatedPdfs                        GeneratedPdf[]
  sentEmailLogs                        EmailLog[]
  uploadedFiles                        StoredFile[]                  @relation("StoredFileUploadedBy")
  confirmedPaymentTransactions         PaymentTransaction[]          @relation("PaymentTransactionConfirmedBy")
  processedPaymentRefunds              PaymentRefund[]               @relation("PaymentRefundProcessedBy")
  issuedPaymentReceipts                PaymentReceipt[]              @relation("PaymentReceiptIssuedBy")
  bankConnections                      BankConnection[]
  notificationPreferences              NotificationPreference[]
  createdTodayNotes                    TodayNote[]                   @relation("TodayNoteCreatedBy")
  kitchenWorkers                       KitchenWorker[]               @relation("KitchenWorkerUser")
  createdSupportTickets                SupportTicket[]               @relation("SupportTicketCreatedBy")
  supportTicketMessages                SupportTicketMessage[]        @relation("SupportTicketMessageAuthor")
  authorizationAuditsAsActor           AuthorizationAudit[]          @relation("AuthorizationAuditActor")
  grantedPrincipalRoles                PrincipalRole[]               @relation("PrincipalRoleGrantedBy")

  @@index([organizationId, isActive])
  @@map("users")
}

model SupportTicket {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdById       String    @map("created_by_id") @db.Uuid
  reference         String    @unique
  subject           String
  description       String
  category          String
  priority          String    @default("NORMAL")
  status            String    @default("SUBMITTED")
  pageUrl           String?   @map("page_url")
  browser           String?
  device            String?
  appVersion        String?   @map("app_version")
  diagnosticContext Json?     @map("diagnostic_context")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  messages     SupportTicketMessage[]

  @@index([organizationId, status, updatedAt])
  @@index([createdById, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  isStaffReply   Boolean  @default(false) @map("is_staff_reply")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?         @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
  @@map("support_ticket_messages")
}

//
// ---------------------------------------------------------------------------
// Authorization.
//
// One rule governs everything below: NO ROLE NAME APPEARS IN APPLICATION CODE
// (INV-1). Code asks "can this principal do X?". Role names exist in exactly two
// places - rows in `roles`, and lib/authz/starter-roles.ts, which is the seed
// that creates the starter set.
//
// Adding a role is an INSERT. Adding a permission KEY is a code change, on
// purpose: a key nothing enforces is not a permission.
//
// FOUR TABLES DECIDE PRIVILEGE - principals, principal_roles,
// principal_permissions, role_permissions - and exactly one function reads them
// (INV-2). See lib/authz/decide.ts.
//
// INVISIBLE TO PRISMA, and lost to any `migrate diff` over these tables:
//   * the CHECK constraints on principals.kind, principal_roles.scope_type,
//     principal_roles.source and principal_permissions.effect
//   * the CHECK that a scope_type of 'org' stores the organization's own id
//   * the three epoch-bump triggers
// Never generate migrations for these tables with `prisma migrate diff`.
// ---------------------------------------------------------------------------
//

/// Every grantable subject in a tenant. Humans and machines alike.
///
/// THIS IS THE STRUCTURAL CHOICE THAT CARRIES THE DESIGN. Grants attach to a
/// principal rather than directly to a person's membership, so revocation,
/// expiry, scope and audit are written once instead of once per kind of caller.
/// A service account gets a principal and the assignment and override paths work
/// on it unchanged - no second privilege model for machines.
///
/// The cost is one table of about thirty lines. That asymmetry is the whole
/// argument: the table is cheap today and a migration across live privilege rows
/// later.
///
/// NO RLS POLICY, DELIBERATELY - see PrincipalPermission for the reasoning that
/// covers all four privilege tables.
model Principal {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// "user" | "service". INVISIBLE TO PRISMA: a CHECK constraint pins it.
  kind           String
  /// Switched off without deleting the grant history behind it.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership           OrganizationMembership?
  serviceAccount       ServiceAccount?
  principalRoles       PrincipalRole[]
  principalPermissions PrincipalPermission[]
  authorizationAudits  AuthorizationAudit[]    @relation("AuthorizationAuditSubject")

  /// The composite-FK target. `id` is already the primary key, so this adds no
  /// uniqueness anyone needed - it exists so every table that names a principal
  /// can carry `organization_id` through the key and make a cross-tenant row
  /// structurally impossible.
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("principals")
}

/// A machine caller: a kitchen display, an integration, an internal job.
///
/// It proves identity with a bearer token rather than a Supabase session, and
/// then it IS a principal - the same resolver, the same tables, the same
/// assignment and override endpoints. That is the payoff of attaching grants to
/// principals: this table adds an authentication mechanism, not an
/// authorization model.
model ServiceAccount {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  principalId    String    @unique @map("principal_id") @db.Uuid
  name           String
  /// SHA-256 of the bearer token. The token itself is shown once, at creation,
  /// and never stored.
  tokenHash      String    @unique @map("token_hash")
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Checked by the resolver on every call, so a lapsed credential stops working
  /// at the moment it lapses rather than when a sweep job notices.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  principal    Principal    @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Same Prisma requirement as on OrganizationMembership: it expresses the
  /// composite one-to-one and constrains nothing `principalId @unique` does not.
  @@unique([principalId, organizationId])
  @@index([organizationId])
  @@map("service_accounts")
}

/// A named bundle of permissions, always owned by exactly one tenant.
///
/// There is no such thing as a global role. The starter five are seeded INTO
/// each organization, which is what lets a tenant edit every cell of them, and
/// what makes "add a role" an INSERT with no schema dimension to reason about.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Stable identity within the tenant. Never branched on by application code.
  key            String
  name           String
  description    String?
  /// SPARSE (100/200/300/400/500) so a tenant can insert "Front Desk" at 350
  /// without renumbering anything. Lower outranks higher, and every comparison
  /// is strict, so equal rank denies.
  ///
  /// Rank answers WHO MAY ACT ON WHOM. It is not the escalation guard - the
  /// subset check is (INV-6) - because the moment a tenant authors a custom
  /// role, rank stops implying anything about content.
  rank           Int
  /// True for the seeded starter five. Their KEY cannot be renamed and they
  /// cannot be deleted (409 system_role_immutable); their permission set stays
  /// fully editable, which is the entire point of per-tenant roles.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  principalRoles  PrincipalRole[]

  @@unique([organizationId, key])
  /// The composite-FK target for `PrincipalRole`.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("roles")
}

/// The permission catalog. GLOBAL, not per-tenant: tenants compose roles out of
/// these keys, they do not invent keys.
///
/// Every row here has a matching member of the `PermissionKey` union in
/// lib/authz/catalog.ts, and vice versa. A test asserts both directions, because
/// a seeded key with no union member is unreachable and a union member with no
/// row can never be granted.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Dotted and lowercase: `resource.action`. `resource.sub.verb` only where the
  /// sub-resource has no independent existence.
  key         String   @unique
  label       String
  description String
  groupLabel  String   @map("group_label")
  /// "Escalates privilege or moves money." The seam the deferred step-up work
  /// hangs off; the role editor uses it to mark a checkbox as consequential.
  isDangerous Boolean  @default(false) @map("is_dangerous")
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions      RolePermission[]
  principalPermissions PrincipalPermission[]

  @@index([sortOrder])
  @@map("permissions")
}

/// Which permissions a role grants. This is where the whole Owner /
/// Administrator difference lives - no code knows Administrator is special.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

/// An assignment is a RESOURCE, with its own id, its own scope, its own expiry
/// and its own provenance - not a join row.
///
/// BOTH foreign keys out of this table are composite and both carry
/// `organization_id`. A row naming a principal in one tenant and a role in
/// another is structurally impossible rather than merely forbidden by a code
/// path someone can forget.
///
/// ONE DIMENSION PER ASSIGNMENT, AND ASSIGNMENTS UNION. "Kitchen Staff at Hall
/// A" is one row; "Viewer for school events" is another. Two Kitchen Staff rows
/// at Hall A and Hall B means both halls. An intersection - "kitchen at Hall A,
/// but only for school events" - is deliberately not expressible; the seam for
/// it is a `principal_role_scopes(principal_role_id, dimension, value_id)` child
/// table where all dimensions on one assignment must match while assignments
/// still union.
///
/// NO NULLABLE DISCRIMINATORS. `scopeType` and `scopeId` are both NOT NULL, with
/// 'org' storing the organization's own id rather than a null. A nullable
/// `scope_id` would need NULLS NOT DISTINCT on the unique index - which Prisma
/// cannot emit - and would satisfy any composite foreign key vacuously under
/// MATCH SIMPLE, silently skipping exactly the rows the key exists to cover.
/// That is the trap the P1B migration already spent a migration escaping on
/// `roles.organization_id`.
model PrincipalRole {
  id             String    @id @default(uuid()) @db.Uuid
  principalId    String    @map("principal_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// "org" | "hall" | "event_type". INVISIBLE TO PRISMA: a CHECK pins the set,
  /// and a second CHECK pins `scope_type = 'org'` to `scope_id = organization_id`.
  scopeType      String    @map("scope_type")
  /// For 'org', the organization's own id.
  scopeId        String    @map("scope_id") @db.Uuid
  /// Evaluated inside the resolver query rather than by a sweep job, so a lapsed
  /// assignment stops granting at the moment it lapses even if nothing has
  /// cleaned it up. Time-boxed elevation needs no other machinery.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  grantedBy      String?   @map("granted_by") @db.Uuid
  /// "manual" | "scim" | "idp_group". Ships now, unused, because deciding
  /// retroactively what every existing row's provenance was is the expensive
  /// part of adding SSO provisioning later. INVISIBLE TO PRISMA: a CHECK.
  source         String    @default("manual")
  createdAt      DateTime  @default(now()) @map("created_at")

  principal     Principal    @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// RESTRICT, not CASCADE: deleting a role people still hold must fail loudly.
  /// The API returns 409 role_in_use, and the database refuses even if that
  /// check is bypassed.
  role          Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  grantedByUser User?        @relation("PrincipalRoleGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([principalId, roleId, scopeType, scopeId])
  @@index([organizationId])
  @@index([roleId])
  @@index([principalId, organizationId])
  @@map("principal_roles")
}

/// Individual exceptions on top of whatever the principal's assignments grant.
/// GRANT adds a key the roles do not carry; DENY removes one they do.
///
/// DENY IS SUBTRACTIVE AND FINAL (INV-4). Effective set = union of role grants,
/// plus GRANT rows, minus DENY rows, applied last, and nothing overrides it. No
/// priorities, no specificity rules, no "most specific wins" - those are how
/// policy engines become unreadable.
///
/// ORG-SCOPED ON PURPOSE. A scoped individual grant is a role of one, and roles
/// are already that mechanism.
///
/// NO RLS POLICY, DELIBERATELY - AND THIS IS THE TABLE THAT SHOWS WHY. Read the
/// ordinary tenant policy against a table whose every row means "this principal
/// holds this permission": a `WITH CHECK` that asks only whether the writer
/// belongs to the organization is satisfied by every member, so any member could
/// INSERT a row granting themselves anything. `FOR SELECT` is not sufficient
/// either - it exposes every colleague's grant map. So: RLS enabled, every
/// privilege revoked from `anon` and `authenticated`, and no policy at all.
///
/// All four privilege tables carry `organization_id` and will therefore pass the
/// mechanical "does it have a tenant column?" test the next maintainer applies
/// to the loop in prisma/supabase-rls.sql. The column is there for the composite
/// foreign keys, NOT to opt in. tests/unit/privilege-table-policies.test.ts is
/// the control, because a comment is not one.
///
/// INVISIBLE TO PRISMA: a CHECK constraint pins `effect` to GRANT or DENY.
model PrincipalPermission {
  id             String   @id @default(uuid()) @db.Uuid
  principalId    String   @map("principal_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  /// "GRANT" | "DENY".
  effect         String
  grantedBy      String?  @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  principal    Principal    @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([principalId, permissionId])
  @@index([organizationId])
  @@index([principalId, organizationId])
  @@map("principal_permissions")
}

/// Append-only trail of privilege changes. Every privilege write appends here in
/// the SAME TRANSACTION as the change and the epoch bump (INV-7) - a change that
/// is visible but unaudited, or audited but not applied, is worse than either
/// failure alone.
///
/// `actorName` and `subjectName` are snapshots, for the same reason
/// `activity_logs.user_name` exists: both foreign keys are SET NULL, so without
/// the snapshot a deleted user's audit entry stops naming anyone - which is
/// exactly when the entry matters most.
///
/// The subject is a PRINCIPAL, not a user, so a change to a service account's
/// grants is auditable in the same table and read by the same screen.
model AuthorizationAudit {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  actorId            String?  @map("actor_id") @db.Uuid
  actorName          String   @map("actor_name")
  subjectPrincipalId String?  @map("subject_principal_id") @db.Uuid
  subjectName        String?  @map("subject_name")
  /// e.g. "role.created", "role.updated", "assignment.created",
  /// "override.replaced", "staff.deactivated".
  action             String
  /// Before/after detail. Shape is the writer's business, not the schema's.
  detail             Json?
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuthorizationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject      Principal?   @relation("AuthorizationAuditSubject", fields: [subjectPrincipalId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([subjectPrincipalId])
  @@index([organizationId, action, createdAt])
  @@map("authorization_audit")
}

