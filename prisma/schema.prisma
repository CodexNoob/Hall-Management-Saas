  /// were part of this closed the whole venue, and reading NULL as "every hall"
  /// keeps those rows meaning exactly what they meant when they were saved.
  /// Nothing writes NULL any more.
  hallId         String?  @map("hall_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  label          String
  reason         String?
  isBlocked      Boolean  @default(true) @map("is_blocked")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hall         Hall?        @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@index([organizationId, startDate, endDate])
  @@index([organizationId, isBlocked, startDate, endDate])
  @@index([organizationId, hallId, startDate, endDate])
  @@index([startDate, endDate])
  @@index([isBlocked])
  @@map("holiday_blocked_dates")
