{
  "name": "hall-management-saas-platform",
  "version": "2.1.0",
  "description": "Event Core hall, event, kitchen, billing, and staff management desktop app.",
  "author": "Event Core",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:public": "playwright test --project=chromium --project=mobile",
    "e2e:authenticated": "playwright test --project=authenticated --project=authenticated-mobile",
    "e2e:mutation": "playwright test --project=mutation",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:tenant-backfill": "prisma db execute --file prisma/multi-tenancy-backfill.sql",
    "db:clients-backfill": "prisma db execute --file prisma/clients-backfill.sql",
    "db:admin-permissions-backfill": "prisma db execute --file prisma/admin-permissions-backfill.sql",
    "db:member-view-access-backfill": "prisma db execute --file prisma/member-view-access-backfill.sql",
    "db:sample-vendors": "prisma db execute --file prisma/sample-vendors.sql",
    "db:billing-strengthening": "prisma db execute --file prisma/billing-strengthening.sql",
    "db:booking-engine": "prisma db execute --file prisma/booking-engine.sql",
    "db:language-setting": "prisma db execute --file prisma/language-setting-backfill.sql",
    "db:erd": "tsx scripts/generate-supabase-erd.ts",
    "db:rls": "prisma db execute --file prisma/supabase-rls.sql",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:icon": "node scripts/generate-electron-icon.mjs",
    "desktop:build": "electron-builder",
    "desktop:publish": "electron-builder --publish always",
    "mobile:add:android": "capacitor add android",
    "mobile:add:ios": "capacitor add ios",
    "mobile:sync": "capacitor sync",
    "mobile:open:android": "capacitor open android",
    "mobile:open:ios": "capacitor open ios"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/server": "^1.2.0",
    "@supabase/supabase-js": "^2.50.2",
    "@tanstack/react-query": "^5.81.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "googleapis": "^150.0.1",
    "hebcal": "^2.3.2",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^0.456.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.1",
    "prettier": "^3.6.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.eventcore.hallmanagement",
    "productName": "Event Core",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.eventcore.app/desktop/"
      }
    ],
    "mac": {
      "target": "dmg"
    }
  }
}
