DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_LAYOUTS=
SUPABASE_STORAGE_BUCKET_PDFS=
SUPABASE_STORAGE_BUCKET_FILES=event-files
ENCRYPTION_KEY=
SESSION_SECRET=
SUPPORT_EMAIL=
RESEND_API_KEY=
BREVO_API_KEY=
SUPPORT_EMAIL_FROM=Event Core Support <support@your-domain.com>
SUPPORT_WEBHOOK_URL=
# Beta access. BETA_APPROVAL_EMAIL is where the "New Event Core beta-access
# request" notification goes; it is read from the environment and never
# hardcoded. Beta notifications use BREVO_API_KEY and SUPPORT_EMAIL_FROM.
BETA_APPROVAL_EMAIL=contactevent.pro1@gmail.com
# Comma-separated addresses approved the moment they register. Leave empty in
# production: every entry is somebody who can create an organization with no
# review. See docs/beta-access.md.
BETA_ACCESS_AUTO_APPROVE_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
GMAIL_ENCRYPTED_REFRESH_TOKEN=
GMAIL_ALLOWED_SENDER_DOMAIN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ENCRYPTED_REFRESH_TOKEN=
# Only used by scripts/backfill-payment-links.ts to seed existing organizations.
# Live payment links are per organization (Settings -> Payments & Gmail); the
# client portal never falls back to a global value.
CARDKNOX_PAYMENT_LINK=
ENABLE_GOOGLE_CALENDAR_SYNC=false
ENABLE_GMAIL_PAYMENT_EMAILS=false
ENABLE_PDF_GENERATION=false
ENABLE_SCHOOL_CYCLES=false
# Prisma's query log only. `debug` prints every SQL statement with its bound
# parameters, so it must not be raised in a deployed environment.
LOG_LEVEL=info
# The application logger. trace|debug|info|warn|error|fatal|silent
APP_LOG_LEVEL=info
E2E_READONLY_EMAIL=
E2E_READONLY_PASSWORD=
E2E_MUTATION_EMAIL=
E2E_MUTATION_PASSWORD=
E2E_LOGOUT_EMAIL=
E2E_LOGOUT_PASSWORD=
# An ACTIVE member of the mutation account's organization that holds NO ROLE at
# all. rbac-enforcement.mutation.spec.ts signs in as it and checks what the API
# really lets it do, so an empty effective set is what makes a 200 there mean
# "the role the test just granted" rather than "something it already had".
E2E_RESTRICTED_EMAIL=
E2E_RESTRICTED_PASSWORD=
# A real mailbox you own. The staff invite E2E test appends +e2e-<timestamp> to
# it so every run is unique but still deliverable. Left unset, that test skips
# rather than send invites to an invented address, because invented recipients
# hard-bounce and bounces count against the sending domain's reputation.
E2E_STAFF_INVITE_EMAIL=
